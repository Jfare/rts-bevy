# ─────────────────────────────────────────────────────────────
# Lightweight Runtime Image using Pre-Built Server Binary
# (Built in CI to save VPS memory and disk space)
# ─────────────────────────────────────────────────────────────
FROM ubuntu:24.04

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    libssl3 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy the pre-built headless server binary
COPY bin/server /app/rts-server
RUN chmod +x /app/rts-server

ENV PORT=8080
ENV RUST_LOG=info

EXPOSE 8080

CMD ["/app/rts-server"]
