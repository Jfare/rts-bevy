# ─────────────────────────────────────────────────────────────
# Lightweight Web Client Static Host & Caddy Reverse Proxy
# (Wasm built in CI to save VPS memory and disk space)
# ─────────────────────────────────────────────────────────────
FROM caddy:2-alpine

COPY dist /srv/web
COPY docker/Caddyfile /etc/caddy/Caddyfile

EXPOSE 80 443

CMD ["caddy", "run", "--config", "/etc/caddy/Caddyfile", "--adapter", "caddyfile"]
